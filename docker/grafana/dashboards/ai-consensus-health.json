{
  "uid": "idc-consensus-health",
  "title": "AI Consensus Health",
  "tags": ["insidedcpulse"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "title": "Consensus Score Over Time", "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "min": 0, "max": 1 }, "overrides": [] },
      "targets": [{ "expr": "insidedcpulse_world_consensus_score", "legendFormat": "consensus score", "refId": "A" }]
    },
    {
      "id": 2, "title": "Reputation per Agent", "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "min": 0, "max": 1 }, "overrides": [] },
      "targets": [{ "expr": "insidedcpulse_agent_reputation", "legendFormat": "{{agent_id}}", "refId": "A" }]
    },
    {
      "id": 3, "title": "Rejection Rate per Agent", "type": "bargauge",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "thresholds": { "steps": [
        { "color": "green", "value": 0 }, { "color": "orange", "value": 0.3 }, { "color": "red", "value": 0.6 }
      ] } }, "overrides": [] },
      "targets": [{ "expr": "insidedcpulse_agent_rejection_rate", "legendFormat": "{{agent_id}}", "refId": "A" }]
    },
    {
      "id": 4, "title": "Agent Divergence (reputation stddev)", "type": "stat",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "stddev(insidedcpulse_agent_reputation)", "legendFormat": "stddev", "refId": "A" }]
    }
  ]
}
