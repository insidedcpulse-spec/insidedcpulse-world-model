{
  "uid": "idc-agent-reputation-map",
  "title": "Agent Reputation Map",
  "tags": ["insidedcpulse"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "title": "Reputation by Agent", "type": "bargauge",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "thresholds": { "steps": [
        { "color": "red", "value": 0 }, { "color": "yellow", "value": 0.3 }, { "color": "green", "value": 0.6 }
      ] } }, "overrides": [] },
      "targets": [{ "expr": "insidedcpulse_agent_reputation", "legendFormat": "{{agent_id}}", "refId": "A" }]
    },
    {
      "id": 2, "title": "Requests per Agent (rate/5m)", "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "rate(insidedcpulse_agent_requests_total[5m])", "legendFormat": "{{agent_id}}", "refId": "A" }]
    },
    {
      "id": 3, "title": "Reputation Over Time", "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "min": 0, "max": 1 }, "overrides": [] },
      "targets": [{ "expr": "insidedcpulse_agent_reputation", "legendFormat": "{{agent_id}}", "refId": "A" }]
    }
  ]
}
