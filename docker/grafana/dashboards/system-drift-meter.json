{
  "uid": "idc-drift-meter",
  "title": "System Drift Meter",
  "tags": ["insidedcpulse"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "title": "Drift EMA (|simulated - committed|)", "type": "timeseries",
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "insidedcpulse_world_drift", "legendFormat": "drift", "refId": "A" }]
    },
    {
      "id": 2, "title": "Current Drift", "type": "gauge",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "min": 0, "max": 5, "thresholds": { "steps": [
        { "color": "green", "value": 0 }, { "color": "orange", "value": 0.5 }, { "color": "red", "value": 1.5 }
      ] } }, "overrides": [] },
      "targets": [{ "expr": "insidedcpulse_world_drift", "refId": "A" }]
    }
  ]
}
