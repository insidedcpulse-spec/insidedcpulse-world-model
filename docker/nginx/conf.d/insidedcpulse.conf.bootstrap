# BOOTSTRAP CONFIG — use this BEFORE the first certbot run (no SSL cert exists yet).
#
#   cp insidedcpulse.conf.bootstrap insidedcpulse.conf
#   docker compose up -d nginx api postgres redis
#   docker compose run --rm certbot certonly --webroot -w /var/www/certbot \
#       -d insidedcpulse.com -d www.insidedcpulse.com --email you@example.com --agree-tos -n
#   cp insidedcpulse.conf.ssl insidedcpulse.conf
#   docker compose restart nginx

server {
    listen 80;
    server_name insidedcpulse.com www.insidedcpulse.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location /grafana/ {
        proxy_pass http://grafana:3000/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        limit_req zone=api_limit burst=40 nodelay;
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws/world-stream {
        proxy_pass http://api:8000/ws/world-stream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }
}
