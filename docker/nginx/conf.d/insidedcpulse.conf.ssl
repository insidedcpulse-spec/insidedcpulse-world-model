# PRODUCTION CONFIG — activate after certbot has issued a certificate.
#   cp insidedcpulse.conf.ssl insidedcpulse.conf && docker compose restart nginx

server {
    listen 80;
    server_name insidedcpulse.com www.insidedcpulse.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name insidedcpulse.com www.insidedcpulse.com;

    ssl_certificate     /etc/letsencrypt/live/insidedcpulse.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/insidedcpulse.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;

    client_max_body_size 1m;

    # Real-time world stream
    location /ws/world-stream {
        proxy_pass http://api:8000/ws/world-stream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    # Grafana public dashboards (no auth) — must keep the /grafana/ prefix
    # on the proxied request, since GF_SERVER_SERVE_FROM_SUB_PATH redirects
    # bare /public-dashboards/* requests back to /grafana/public-dashboards/*,
    # causing a redirect loop through the prefix-stripping location below.
    location /grafana/public-dashboards/ {
        proxy_pass http://grafana:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Grafana dashboards (observability only — not memory)
    # No trailing slash on proxy_pass: preserves the /grafana/ prefix.
    # Grafana 13 with GF_SERVER_SERVE_FROM_SUB_PATH=true 301-redirects bare
    # "/" to root_url ("https://.../grafana/"); stripping the prefix here
    # would send "/" upstream and create the same redirect loop fixed below
    # for /grafana/public-dashboards/.
    location /grafana/ {
        proxy_pass http://grafana:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Prometheus metrics endpoint stays internal to the docker network
    location /metrics {
        deny all;
    }

    # Google Search Console site verification
    location = /google6OT34y25WROPmIz7NBJAKFE1eA_afRxNssY--XACZfI.html {
        default_type "text/html";
        return 200 "google-site-verification: 6OT34y25WROPmIz7NBJAKFE1eA_afRxNssY--XACZfI";
    }

    location = /googleef0bdd113ef68317.html {
        default_type "text/html";
        return 200 "google-site-verification: googleef0bdd113ef68317.html";
    }

    # Deploy webhook (forwarded to host listener on port 9001)
    location /hooks/deploy {
        proxy_pass http://host.docker.internal:9001/hooks/deploy;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-GitHub-Event $http_x_github_event;
        proxy_set_header X-Hub-Signature-256 $http_x_hub_signature_256;
    }

    # MCP server (streamable HTTP — long-lived, unbuffered)
    location /mcp {
        proxy_pass http://api:8000/mcp;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    # Public status page (static, Grafana public dashboards embedded)
    location = /status {
        alias /usr/share/nginx/html/static/status.html;
    }

    # Sitemap / robots for search engines and LLM crawlers
    location = /sitemap.xml {
        alias /usr/share/nginx/html/static/sitemap.xml;
    }

    location = /robots.txt {
        alias /usr/share/nginx/html/static/robots.txt;
    }

    location = /llms.txt {
        alias /usr/share/nginx/html/static/llms.txt;
    }

    location = /.well-known/mcp-registry-auth {
        alias /usr/share/nginx/html/static/mcp-registry-auth;
    }

    # Human-readable landing page
    location = / {
        root /usr/share/nginx/html/static;
        try_files /index.html =404;
    }

    # Public API
    location / {
        limit_req zone=api_limit burst=40 nodelay;
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
