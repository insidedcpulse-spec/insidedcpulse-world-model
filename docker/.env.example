# Copy to .env and fill in real secrets. Never commit .env.

POSTGRES_PASSWORD=change-me-postgres-password
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# Used by /api/v1/world/commit (internal-only event injection)
INTERNAL_API_KEY=change-me-internal-key

# Used by /api/v1/agents/register (provisioning new agent API keys)
ADMIN_API_KEY=change-me-admin-key
